{
  "name": "drop",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "generate": "turbo run generate",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf .pnpm-home .pnpm-store .turbo node_modules out",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "pnpm --filter=@repo/nest db:generate",
    "db:deploy": "pnpm --filter=@repo/nest db:deploy",
    "db:studio": "pnpm --filter=@repo/nest db:studio"
  },
  "devDependencies": {
    "@repo/tooling": "workspace:*",
    "eslint-plugin-turbo": "catalog:",
    "graphql-config": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "catalog:",
    "@rolldown/binding-linux-x64-musl": "catalog:",
    "@rspack/binding-linux-x64-gnu": "catalog:",
    "@rspack/binding-linux-x64-musl": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
